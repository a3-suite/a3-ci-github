{
  "name": "@a3-suite/ci-annotated-tag-resolver",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub Action for resolving annotated tags",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify",
    "lint": "tsc --noEmit",
    "test:contract": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-annotated-tag-resolver/tests/action-contract.test.ts actions/ci-annotated-tag-resolver/tests/entrypoint.test.ts",
    "test:contract:coverage": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-annotated-tag-resolver/tests/action-contract.test.ts actions/ci-annotated-tag-resolver/tests/entrypoint.test.ts --coverage",
    "test": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-annotated-tag-resolver/tests/"
  },
  "dependencies": {
    "@actions/core": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
