{
  "name": "@a3-suite/ci-release-notes-input-resolution",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub Action for selecting release notes inputs",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify",
    "lint": "tsc --noEmit",
    "test:contract": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-release-notes-input-resolution/tests/action-contract.test.ts actions/ci-release-notes-input-resolution/tests/entrypoint.test.ts",
    "test:contract:coverage": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-release-notes-input-resolution/tests/action-contract.test.ts actions/ci-release-notes-input-resolution/tests/entrypoint.test.ts --coverage",
    "test": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-release-notes-input-resolution/tests/"
  },
  "dependencies": {
    "@actions/core": "1.11.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vercel/ncc": "0.38.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yaml": "^2.7.0"
  }
}
