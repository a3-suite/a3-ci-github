{
  "name": "@a3-suite/ci-release-publication-control",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "GitHub Action for release publication control handoffs",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify --no-cache",
    "lint": "tsc --noEmit",
    "test:contract": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-release-publication-control/tests/action-contract.test.ts actions/ci-release-publication-control/tests/entrypoint.test.ts",
    "test": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-release-publication-control/tests/"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
