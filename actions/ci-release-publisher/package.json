{
  "name": "@a3-suite/ci-release-publisher",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "GitHub Action for bounded owner-approved Release publication",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify --no-cache",
