{
  "name": "@a3-suite/ci-platform-matrix",
  "private": true,
  "version": "0.2.0",
  "description": "GitHub Action for validating a CI platform manifest",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify",
    "lint": "tsc --noEmit",
    "test:contract": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-platform-matrix/tests/action-contract.test.ts actions/ci-platform-matrix/tests/entrypoint.test.ts",
    "test:contract:coverage": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-platform-matrix/tests/action-contract.test.ts actions/ci-platform-matrix/tests/entrypoint.test.ts --coverage",
    "test": "npm run build && node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.mjs actions/ci-platform-matrix/tests/"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vercel/ncc": "0.38.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
