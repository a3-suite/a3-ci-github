{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "typeRoots": [
      "../../actions/ci-release-supplemental-asset/node_modules/@types"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "cli.ts",
    "../release-publication/**/*.ts"
  ],
  "exclude": [
    "../release-publication/tests"
  ]
}
